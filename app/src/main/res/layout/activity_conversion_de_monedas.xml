<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ConversionDeMonedas">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:contentDescription="@string/logoDescripcion"
            app:srcCompat="@drawable/logo_app_png"
            app:layout_constraintWidth_percent="0.5"
            app:layout_maxWidth="250dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/titulo_app"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorBackgroundFloating"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:layout_constraintWidth_max="500dp"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtIdioma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_idioma"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/btnIdiomaES"
                    app:layout_constraintBottom_toBottomOf="@id/btnIdiomaES"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <Button
                    android:id="@+id/btnIdiomaES"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?android:attr/borderlessButtonStyle"
                    android:text="🇪🇸"
                    android:textSize="18sp"
                    android:minWidth="40dp"
                    android:padding="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/txtIdioma" />

                <Button
                    android:id="@+id/btnIdiomaEN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?android:attr/borderlessButtonStyle"
                    android:text="🇺🇸"
                    android:textSize="18sp"
                    android:minWidth="40dp"
                    android:padding="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/btnIdiomaES" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTema"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#00BCD4"
                    app:trackTint="#4FC3F7"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <TextView
                    android:id="@+id/txtTema"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/txt_tema"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/switchTema"
                    app:layout_constraintBottom_toBottomOf="@id/switchTema"
                    app:layout_constraintRight_toLeftOf="@id/switchTema" />

                <TextView
                    android:id="@+id/tvLabelOrigen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/txt_moneda_origen"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/btnIdiomaES"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <Spinner
                    android:id="@+id/spinnerOrigen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelOrigen"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/edtMonto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#4FC3F7"
                    android:hint="@string/hint_monto"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="#B0BEC5"
                    app:layout_constraintTop_toTopOf="@id/spinnerOrigen"
                    app:layout_constraintBottom_toBottomOf="@id/spinnerOrigen"
                    app:layout_constraintLeft_toRightOf="@id/spinnerOrigen"
                    app:layout_constraintRight_toRightOf="parent" />

                <ImageButton
                    android:id="@+id/btnIntercambiar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Intercambiar monedas"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_intercambiar"
                    app:layout_constraintTop_toBottomOf="@id/spinnerOrigen"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <TextView
                    android:id="@+id/tvLabelDestino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/txt_moneda_destino"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/btnIntercambiar"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <Spinner
                    android:id="@+id/spinnerDestino"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelDestino"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <TextView
                    android:id="@+id/txtResultado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="start|center_vertical"
                    android:text="@string/txt_resultado_inicial"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/spinnerDestino"
                    app:layout_constraintBottom_toBottomOf="@id/spinnerDestino"
                    app:layout_constraintLeft_toRightOf="@id/spinnerDestino"
                    app:layout_constraintRight_toRightOf="parent" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSonido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:checked="true"
                    android:text="@string/txt_sonido"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintTop_toBottomOf="@id/spinnerDestino"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <TextView
                    android:id="@+id/txtNivelMultiplicador"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/txt_seekbar_inicial"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintTop_toBottomOf="@id/switchSonido"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <SeekBar
                    android:id="@+id/seekBarNivel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    app:layout_constraintTop_toBottomOf="@id/txtNivelMultiplicador"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:max="100"
                    android:progress="0"
                    app:layout_constraintTop_toBottomOf="@id/seekBarNivel"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <Button
                    android:id="@+id/btnConvertir"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#00BCD4"
                    android:text="@string/btn_convertir"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/progressBar"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <Button
                    android:id="@+id/btnLimpiar"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#F44336"
                    android:text="@string/btn_limpiar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/btnConvertir"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <Button
                    android:id="@+id/btnVolverMenu"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#141414"
                    android:text="@string/btn_volver_menu"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/btnLimpiar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/txtVideo"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            app:layout_constraintTop_toBottomOf="@id/cardPrincipal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="#000000"
            app:use_controller="true"
            app:resize_mode="fit"
            app:layout_constraintWidth_max="600dp"
            app:layout_constraintTop_toBottomOf="@id/txtVideo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>