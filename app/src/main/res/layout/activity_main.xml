<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Guideline central para una alineación horizontal perfecta -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Menú App"
        android:textSize="32sp"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitulo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Elige ¿qué aplicación quieres usar?"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="32dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintBottom_toTopOf="@id/btnEncuestaApp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Button
        android:id="@+id/btnEncuestaApp"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginVertical="10dp"
        android:text="Encuestas App"
        android:textSize="16sp"
        app:layout_constraintWidth_percent="0.8"
        app:layout_maxWidth="400dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
        app:layout_constraintBottom_toTopOf="@id/btnPesoApp"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <Button
        android:id="@+id/btnPesoApp"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginVertical="10dp"
        android:text="Conversión de peso App"
        android:textSize="16sp"
        app:layout_constraintWidth_percent="0.8"
        app:layout_maxWidth="400dp"
        app:layout_constraintTop_toBottomOf="@id/btnEncuestaApp"
        app:layout_constraintBottom_toTopOf="@id/btnMonedasApp"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <Button
        android:id="@+id/btnMonedasApp"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginVertical="10dp"
        android:text="Conversión de monedas App"
        android:textSize="16sp"
        app:layout_constraintWidth_percent="0.8"
        app:layout_maxWidth="400dp"
        app:layout_constraintTop_toBottomOf="@id/btnPesoApp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

</androidx.constraintlayout.widget.ConstraintLayout>