<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Menú App"
        android:textSize="28sp"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Elige ¿qué aplicación quieres usar?"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnEncuestaApp"
        android:layout_width="300dp"
        android:layout_height="56dp"
        android:layout_marginVertical="8dp"
        android:text="Encuestas App"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnPesoApp"
        android:layout_width="300dp"
        android:layout_height="56dp"
        android:layout_marginVertical="8dp"
        android:text="Conversión de peso App"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnMonedasApp"
        android:layout_width="300dp"
        android:layout_height="56dp"
        android:layout_marginVertical="8dp"
        android:text="Conversión de monedas App"
        android:textSize="16sp" />

</LinearLayout>