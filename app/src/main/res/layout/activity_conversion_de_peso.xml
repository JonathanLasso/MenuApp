<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ConversionDePeso">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:title="@string/app_name3"
        app:titleTextColor="?attr/colorOnPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/titulo"
        android:textColor="?attr/colorSecondary"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/editValor"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:id="@+id/editValor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:importantForAutofill="no"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:textColor="?attr/colorSecondary"
        android:hint="@string/placeHolder"
        android:textColorHint="?attr/colorSecondaryContainer"
        android:textSize="18sp"
        app:layout_constraintWidth_percent="0.65"
        app:layout_maxWidth="320dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintBottom_toTopOf="@id/tvLabelDesde"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <TextView
        android:id="@+id/tvLabelDesde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/unidadDesde"
        android:textColor="?attr/colorSecondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/editValor"
        app:layout_constraintBottom_toTopOf="@id/spinnerFrom1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Spinner
        android:id="@+id/spinnerFrom1"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:entries="@array/unidades_peso"
        android:background="?attr/colorSecondaryContainer"
        android:spinnerMode="dropdown"
        app:layout_constraintWidth_percent="0.65"
        app:layout_maxWidth="320dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelDesde"
        app:layout_constraintBottom_toTopOf="@id/btnInvertir"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <ImageButton
        android:id="@+id/btnInvertir"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="?attr/colorPrimary"
        android:src="@drawable/ic_intercambio"
        app:tint="?attr/colorSecondary"
        android:contentDescription="@string/descripcionImagen"
        app:layout_constraintTop_toBottomOf="@id/spinnerFrom1"
        app:layout_constraintBottom_toTopOf="@id/tvLabelHacia"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <TextView
        android:id="@+id/tvLabelHacia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/unidadHacia"
        android:textColor="?attr/colorSecondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btnInvertir"
        app:layout_constraintBottom_toTopOf="@id/spinnerFrom2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Spinner
        android:id="@+id/spinnerFrom2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:entries="@array/unidades_peso"
        android:background="?attr/colorSecondaryContainer"
        android:spinnerMode="dropdown"
        app:layout_constraintWidth_percent="0.65"
        app:layout_maxWidth="320dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelHacia"
        app:layout_constraintBottom_toTopOf="@id/btnConvertir"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <Button
        android:id="@+id/btnConvertir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="?attr/colorPrimary"
        android:text="@string/btnTitulo"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintWidth_percent="0.5"
        app:layout_maxWidth="250dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerFrom2"
        app:layout_constraintBottom_toTopOf="@id/btnVolverMenu"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <Button
        android:id="@+id/btnVolverMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="?attr/colorPrimary"
        android:text="@string/btnVolverMenu"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintWidth_percent="0.5"
        app:layout_maxWidth="250dp"
        app:layout_constraintTop_toBottomOf="@id/btnConvertir"
        app:layout_constraintBottom_toTopOf="@id/tvResultado"
        app:layout_constraintLeft_toLeftOf="@id/glCenter"
        app:layout_constraintRight_toRightOf="@id/glCenter" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:textColor="?attr/colorSecondary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnVolverMenu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>